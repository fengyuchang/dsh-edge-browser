@@ -0,0 +1,52 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { parseSemanticSelector, resolveSemanticSelector } from "../semantic-selector";
+import type { CdpRunner } from "../shared";
+
+afterEach(() => { vi.restoreAllMocks(); document.body.innerHTML = ""; });
+describe("semantic selectors", () => {
+  it("parses exact literal names without treating data as code", () => {
+    expect(parseSemanticSelector('role=button[name="提交"]')).toEqual({ kind: "role", role: "button", value: "提交" });
+    expect(parseSemanticSelector('text="a\\\"b"')).toEqual({ kind: "text", value: 'a"b' });
+    expect(parseSemanticSelector("#submit")).toBeNull();
+    expect(() => parseSemanticSelector('role=button[name="bad"][onclick=x]')).toThrow();
+    expect(() => parseSemanticSelector("label=")).toThrow();
+  });
+  it("uses browser accessibility names, excludes ignored nodes and refuses ambiguity", async () => {
+    let nodes = [{ ignored: true, backendDOMNodeId: 9, role: { value: "button" }, name: { value: "Go" } }, { backendDOMNodeId: 2, role: { value: "button" }, name: { value: "Go" } }];
+    const send = vi.fn(async (_tab: number, _method: string, _params?: object) => ({ nodes })), cdp = { send } as unknown as CdpRunner;
+    expect(await resolveSemanticSelector(cdp, 1, 7, 'role=button[name="Go"]')).toMatchObject({ backendNodeId: 2, cdpTarget: { tabId: 1 } });
+    expect(send.mock.calls.map(call => call[1])).toEqual(["Accessibility.enable", "Accessibility.getFullAXTree", "Accessibility.disable"]);
+    nodes = [...nodes, { backendDOMNodeId: 3, role: { value: "button" }, name: { value: "Go" } }];
+    expect(await resolveSemanticSelector(cdp, 1, 7, "role=button[name=Go]")).toMatchObject({ code: "invalid_params" });
+  });
+  it("label lookup selects the associated control rather than its static label text", async () => {
+    const cdp = { send: async () => ({ nodes: [{ backendDOMNodeId: 2, role: { value: "StaticText" }, name: { value: "Email" } }, { backendDOMNodeId: 3, role: { value: "textbox" }, name: { value: "Email" } }] }) } as unknown as CdpRunner;
+    expect(await resolveSemanticSelector(cdp, 1, 7, "label=Email")).toMatchObject({ backendNodeId: 3 });
+  });
+  it("releases only the original accessibility attachment after a failed lookup", async () => {
+    const send = vi.fn(async (_tab: number, method: string) => {
+      if (method === "Accessibility.getFullAXTree") throw new Error("renderer unavailable");
+      return {};
+    });
+    const cdp = { send, getAttachmentId: () => "original", sendGuarded: vi.fn(async () => ({})) } as unknown as CdpRunner;
+    await expect(resolveSemanticSelector(cdp, 1, 7, "label=Email")).rejects.toThrow("renderer unavailable");
+    expect(cdp.sendGuarded).toHaveBeenCalledWith({ tabId: 1 }, "Accessibility.disable", {}, { attachmentId: "original" });
+  });
+  it("literal DOM lookup ignores hidden duplicates and releases only its own object", async () => {
+    document.body.innerHTML = '<button style="display:none">Next</button><button data-testid="next"><span>Next</span></button><input placeholder="Search">';
+    vi.spyOn(Element.prototype, "getClientRects").mockImplementation(function(this: Element) { return (this.getAttribute("style")?.includes("none") ? [] : [{ width: 100, height: 30 }]) as unknown as DOMRectList; });
+    let selected: Element | null = null;
+    const send = vi.fn(async (_tab, method, params) => {
+      if (method === "Runtime.evaluate") { selected = Function(`return ${params.expression}`)(); return { result: selected ? { objectId: "selected" } : { subtype: "null" } }; }
+      if (method === "DOM.describeNode") return { node: { backendNodeId: selected?.tagName === "BUTTON" ? 11 : 12 } };
+      return {};
+    });
+    const cdp = { send } as unknown as CdpRunner;
+    expect(await resolveSemanticSelector(cdp, 1, 7, "text=Next")).toMatchObject({ backendNodeId: 11 });
+    expect(send).toHaveBeenCalledWith(1, "Runtime.releaseObject", { objectId: "selected" });
+    expect(await resolveSemanticSelector(cdp, 1, 7, "placeholder=Search")).toMatchObject({ backendNodeId: 12 });
+    expect(await resolveSemanticSelector(cdp, 1, 7, "testid=next")).toMatchObject({ backendNodeId: 11 });
+    expect(await resolveSemanticSelector(cdp, 1, 7, "text=x');globalThis.injected=true;//")).toMatchObject({ code: "not_found" });
+    expect((globalThis as { injected?: boolean }).injected).toBeUndefined();
+  });
+});
