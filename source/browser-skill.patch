index 0000000..daeb353
--- /dev/null
+++ b/packages/dsh-plugin-browserskill/src/dsh-operations.ts
@@ -0,0 +1,151 @@
+import { readFile } from "node:fs/promises";
+import { defineTool, type ToolDefinition, type ToolRunContext } from "@deepseek-ai/dsh-tools";
+import { DSH_BUILD_VERSION } from "./dsh-build-info";
+import { parseBskJson } from "./runner";
+import { EXPECT_PARAM, validateExpectations } from "./tool-params";
+import { createStepReceiptHandler } from "./step-receipt";
+import type { ToolDeps } from "./tools";
+
+// Only native batch children can carry this symbol; model arguments cannot grant a queue lease.
+export const DSH_BATCH_QUEUE = Symbol("dsh-batch-queue");
+export const DSH_BATCH_RECEIPT = Symbol("dsh-batch-step-receipt");
+type BatchContext = ToolRunContext & {
+  [DSH_BATCH_QUEUE]?: string;
+  [DSH_BATCH_RECEIPT]?: boolean;
+  observationContext?: string;
+  observationId?: string;
+  actionExpectations?: unknown;
+};
+
+type Timing = { operation: string; queueMs: number; commandMs: number; totalMs: number; outcome: string };
+const timings = new WeakMap<ToolDeps, Array<Timing & { session: string }>>();
+const compatibleSessions = new WeakMap<ToolDeps, Set<string>>();
+export async function checkAdvancedCompatibility(deps: ToolDeps, session: string, exec: ToolRunContext): Promise<void> {
+  const identity = `${session}:${deps.registry.requestFor(session)}`;
+  if (compatibleSessions.get(deps)?.has(identity)) return;
+  const result = await deps.queue.run(session, () => deps.runner.run(["debug", "capabilities", "--session", session], { signal: exec.signal, timeoutMs: 10_000, tag: session }), exec.signal);
+  const capabilities = parseBskJson(result, "browser version check") as { capabilities?: { extension?: { integration_version?: string } } };
+  if (capabilities.capabilities?.extension?.integration_version !== DSH_BUILD_VERSION)
+    throw new Error("Browser extension and Harness plugin revisions do not match. Finish current tasks and reload the updated Edge extension; no input was sent.");
+  const known = compatibleSessions.get(deps) ?? new Set<string>();
+  if (known.size >= 64) known.clear();
+  known.add(identity); compatibleSessions.set(deps, known);
+}
+export function recordDshTiming(deps: ToolDeps, session: string, timing: Timing): void {
+  const history = timings.get(deps) ?? [];
+  history.push({ session, ...timing });
+  if (history.length > 128) history.shift();
+  timings.set(deps, history);
+}
+
+const ACTIONS = ["click", "fill", "press", "select", "hover", "wheel", "scroll-to"] as const;
+export const BATCH_PARAMETERS = {
+  steps: {
+    type: "array",
+    description: "Batch: 1..8 already-decided targeted actions. Stops on the first failure, handoff or deadline; never retries. No session/context overrides.",
+    items: { type: "object", additionalProperties: false, properties: {
+      action: { type: "string", enum: ACTIONS, required: true },
+      target: { type: "string", required: true },
+      value: { type: "string" }, key: { type: "string" },
+      values: { type: "array", items: { type: "string" } },
+      deltaX: { type: "number" }, deltaY: { type: "number" },
+      expect: EXPECT_PARAM,
+    } },
+  },
+} as const;
+
+const output = { schema: { type: "json" as const }, render: (_args: unknown, value: unknown) => [{ type: "text" as const, text: JSON.stringify(value) }] };
+
+export function createDshOperations(deps: ToolDeps, step: ToolDefinition): ToolDefinition[] {
+  const receipts = createStepReceiptHandler();
+  return [defineTool({
+    name: "interact.batch", description: "Run a small decided sequence under one owned session queue. No automatic replay or rollback.",
+    parameters: { session: { type: "string" }, tabId: { type: "integer" }, timeoutMs: { type: "integer" }, ...BATCH_PARAMETERS }, output,
+    async execute(args, rawExec) {
+      const exec = rawExec as BatchContext;
+      if (!Array.isArray(args.steps) || args.steps.length < 1 || args.steps.length > 8) throw new Error("batch requires 1..8 steps");
+      const steps = args.steps;
+      if (!exec.observationContext) throw new Error("batch requires the actual contextId from sync");
+      const budget = args.timeoutMs ?? 30_000;
+      if (!Number.isSafeInteger(budget) || budget < 1000 || budget > 60_000) throw new Error("batch timeoutMs must be in 1000..60000");
+      const allowed = new Set(["action", "target", "value", "key", "values", "deltaX", "deltaY", "expect"]);
+      for (const row of steps) {
+        if (!row || typeof row !== "object" || Array.isArray(row) || Object.keys(row).some(key => !allowed.has(key))) throw new Error("batch step contains unsupported fields");
+        if (!(ACTIONS as readonly string[]).includes(row.action) || typeof row.target !== "string" || !row.target.trim() || row.target.length > 2048) throw new Error("batch requires supported targeted actions");
