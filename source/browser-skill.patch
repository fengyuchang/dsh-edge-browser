diff --git a/apps/extension/src/tools/semantic-selector.ts b/apps/extension/src/tools/semantic-selector.ts
new file mode 100644
index 0000000..ff4ff7c
--- /dev/null
+++ b/apps/extension/src/tools/semantic-selector.ts
@@ -0,0 +1,100 @@
+import { rpcError } from "./errors";
+import type { CdpRunner } from "./shared";
+
+const CONTROL_ROLES = new Set([
+  "button", "checkbox", "combobox", "listbox", "radio", "searchbox",
+  "slider", "spinbutton", "switch", "textbox",
+]);
+const invalid = (message: string) => ({ code: "invalid_params" as const, message });
+
+type Locator = { kind: "role" | "label" | "text" | "placeholder" | "testid"; value: string; role?: string };
+
+export function parseSemanticSelector(selector: string): Locator | null {
+  const prefix = /^(role|label|text|placeholder|testid)=/.exec(selector);
+  if (!prefix) return null;
+  const kind = prefix[1] as Locator["kind"];
+  let raw = selector.slice(prefix[0].length), role: string | undefined;
+  if (kind === "role") {
+    const parsed = /^([a-z][a-z0-9-]*)(?:\[name=(.*)\])?$/i.exec(raw);
+    if (!parsed) throw new Error('Use role=button[name="Submit"] or a snapshot ref');
+    role = parsed[1].toLowerCase();
+    raw = parsed[2] ?? "";
+  }
+  let value = raw.startsWith('"') ? JSON.parse(raw) : raw;
+  if (typeof value !== "string" || value.length > 500 || value.includes("\0"))
+    throw new Error("Semantic locator must be a literal string of at most 500 characters");
+  value = value.replace(/\s+/g, " ").trim();
+  if (!value && kind !== "role") throw new Error("Semantic locator must not be empty");
+  return { kind, value, ...(role ? { role } : {}) };
+}
+
+// Literal DOM lookups return a concrete node, never generated page instructions.
+// ponytail: text/attribute lookup is main-document only; use observed refs for frames/shadow roots.
+function findDomTarget(kind: string, value: string): Element | null {
+  const normalize = (text: string | null) => (text ?? "").replace(/\s+/g, " ").trim();
+  const visible = (element: Element) => {
+    const style = getComputedStyle(element);
+    return style.display !== "none" && style.visibility !== "hidden" && style.visibility !== "collapse"
+      && [...element.getClientRects()].some(rect => rect.width > 0 && rect.height > 0);
+  };
+  const attribute = kind === "placeholder" ? "placeholder" : "data-testid";
+  const nodes = [...document.querySelectorAll(kind === "text" ? "body *" : `[${attribute}]`)];
+  if (nodes.length > 20_000) throw new Error("Semantic lookup is too broad; use an observed ref or CSS selector");
+  let matches = nodes.filter(element => !element.closest("browser-skill-overlay,[data-bsk-overlay]")
+    && normalize(kind === "text" ? element.textContent : element.getAttribute(attribute)) === value && visible(element));
+  if (matches.length > 64) throw new Error("Semantic lookup is too broad; use an observed ref or CSS selector");
+  if (kind === "text") {
+    const interactive = matches.filter(element => element.matches("button,a[href],input,select,textarea,[role=button],[role=link],[role=menuitem],[role=tab],[role=option]"));
+    matches = interactive.length ? interactive : matches.filter(element => !matches.some(other => other !== element && element.contains(other)));
+  }
+  if (matches.length > 1) throw new Error(`Semantic locator matched ${matches.length} visible elements; use an observed ref or narrower selector`);
+  return matches[0] ?? null;
+}
+
+export async function resolveSemanticSelector(cdp: CdpRunner, tabId: number, _rootNodeId: number, selector: string) {
+  let locator: Locator | null;
+  try { locator = parseSemanticSelector(selector); }
+  catch (error) { return invalid(String((error as Error).message)); }
+  if (!locator) return null;
+  const resolved = (backendNodeId: number) => ({ backendNodeId, cdpTarget: { tabId }, usedSelector: selector });
+  const missing = () => rpcError("not_found", "selector_not_found", "No currently visible element matched this literal semantic locator; check its name in a fresh observation. This is not an unknown snapshot ref; no input was sent.");
+  if (locator.kind === "role" || locator.kind === "label") {
+    // queryAXTree waits for a rendering lifecycle update that minimized pages
+    // may never produce. getFullAXTree forces the same browser-computed names
+    // and already uses the driver's bounded read/late-reply protection.
+    await cdp.send(tabId, "Accessibility.enable", {});
+    const attachmentId = cdp.getAttachmentId?.(tabId);
+    let reply;
+    try {
+      reply = await cdp.send<{ nodes: Array<{ ignored?: boolean; backendDOMNodeId?: number; role?: { value: string }; name?: { value: string } }> }>(tabId, "Accessibility.getFullAXTree", {});
+    } finally {
+      if (cdp.getAttachmentId?.(tabId) === attachmentId) {
+        await (cdp.sendGuarded && attachmentId !== undefined
+          ? cdp.sendGuarded({ tabId }, "Accessibility.disable", {}, { attachmentId })
+          : cdp.send(tabId, "Accessibility.disable", {})).catch(() => {});
+      }
+    }
+    if (reply.nodes.length > 20_000) return invalid("Semantic lookup is too broad; use an observed ref or CSS selector");
+    const ids = [...new Set(reply.nodes.filter(node => !node.ignored && node.backendDOMNodeId
+      && (!locator.role || node.role?.value.toLowerCase() === locator.role)
+      && (!locator.value || node.name?.value.replace(/\s+/g, " ").trim() === locator.value)
+      && (locator.kind !== "label" || CONTROL_ROLES.has(node.role?.value.toLowerCase() ?? "")))
+      .map(node => node.backendDOMNodeId!))];
+    if (ids.length > 1) return invalid(`Semantic locator matched ${ids.length} accessible elements; use an observed ref or narrower selector`);
+    return ids.length ? resolved(ids[0]) : missing();
+  }
+  let objectId: string | undefined;
+  try {
+    const reply = await cdp.send<{ result: { objectId?: string; subtype?: string; description?: string }; exceptionDetails?: { text?: string; exception?: { description?: string } } }>(tabId, "Runtime.evaluate", {
+      expression: `(${findDomTarget.toString()})(${JSON.stringify(locator.kind)},${JSON.stringify(locator.value)})`,
+      returnByValue: false,
+    });
+    objectId = reply.result.objectId;
+    if (reply.exceptionDetails) return invalid("Semantic lookup was ambiguous or exceeded its bound; use an observed ref or narrower selector");
+    if (!objectId || reply.result.subtype === "null") return missing();
+    const description = await cdp.send<{ node: { backendNodeId: number } }>(tabId, "DOM.describeNode", { objectId });
+    return resolved(description.node.backendNodeId);
+  } finally {
+    if (objectId) await cdp.send(tabId, "Runtime.releaseObject", { objectId }).catch(() => {});
+  }
+}
