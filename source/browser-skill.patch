diff --git a/packages/dsh-plugin-browserskill/tests/dsh-batch.test.ts b/packages/dsh-plugin-browserskill/tests/dsh-batch.test.ts
new file mode 100644
index 0000000..ec574b9
--- /dev/null
+++ b/packages/dsh-plugin-browserskill/tests/dsh-batch.test.ts
@@ -0,0 +1,57 @@
+import { DSH_BUILD_VERSION } from "../src/dsh-build-info";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createStepRuntime, STEP_SUCCESS, STEP_PARTIAL, stepReply } from "./helpers/step-runtime";
+
+const cleanups: Array<() => Promise<void>> = [];
+afterEach(async () => { for (const dispose of cleanups.splice(0)) await dispose(); });
+const steps = [{ action: "fill", target: "label=Email", value: "private@example.test" }, { action: "click", target: 'role=button[name="Continue"]' }, { action: "press", target: "#code", key: "Enter" }];
+async function host(run: Parameters<typeof createStepRuntime>[0]) { const runtime = await createStepRuntime(async (args, options) => args[0] === "debug" ? stepReply({ capabilities: { extension: { integration_version: DSH_BUILD_VERSION } } }, 0) : run(args, options)); cleanups.push(runtime.dispose); return runtime; }
+function receipt(result: { content: Array<{ type: string; text?: string }> }) { const block = result.content.at(-1); return block?.text ? JSON.parse(block.text) : undefined; }
+
+describe("bounded native batch", () => {
+  it("holds the session queue across all steps so other calls cannot interleave", async () => {
+    let entered!: () => void, release!: () => void;
+    const ready = new Promise<void>(resolve => { entered = resolve; }),gate = new Promise<void>(resolve => { release = resolve; });
+    const run = vi.fn(async (_args: string[]) => { if (run.mock.calls.length === 1) { entered();await gate; } return stepReply(STEP_SUCCESS, 0); });
+    const runtime = await host(run),batch = runtime.execute(undefined, { action: "batch", contextId: "ctx-before", steps }, "batch-owner");
+    await ready;const outside = runtime.execute(undefined, { contextId: "ctx-after" }, "outside-owner");
+    await new Promise(resolve => setImmediate(resolve));expect(run).toHaveBeenCalledTimes(1);release();
+    const results = await Promise.all([batch,outside]);expect(results.every(result => !result.isError)).toBe(true);
+    expect(run).toHaveBeenCalledTimes(4);const args = run.mock.calls.at(-1)![0];expect(JSON.parse(args[args.indexOf("--params") + 1]).ref).toBe("e1");
+  });
+  it("refuses a mismatched active extension before sending input", async () => {
+    const run = vi.fn(async (_args: string[]) => stepReply({ capabilities: { extension: { integration_version: "0.4.2-dsh.4" } } }, 0));
+    const runtime = await createStepRuntime(run);cleanups.push(runtime.dispose);
+    const result = await runtime.execute(undefined, { action: "batch", contextId: "ctx-before", steps });
+    expect(result.isError).toBe(true);expect(run).toHaveBeenCalledTimes(1);expect(run.mock.calls[0][0][0]).toBe("debug");
+  });
+  it("reuses native step, advances context and returns one final observation without echoing submitted values", async () => {
+    let count = 0;
+    const run = vi.fn(async (args: string[]) => stepReply({ ...STEP_SUCCESS, post: { ...STEP_SUCCESS.post, context_id: `ctx-${++count}`, observation_id: `obs-${count}` } }, 0));
+    const runtime = await host(run);
+    const result = await runtime.execute(undefined, { action: "batch", contextId: "ctx-before", steps });
+    expect(result.isError, JSON.stringify(result.content)).toBe(false);expect(run).toHaveBeenCalledTimes(3);
+    expect(run.mock.calls.map(([args]) => args[args.indexOf("--context") + 1])).toEqual(["ctx-before", "ctx-1", "ctx-2"]);
+    const value = receipt(result);expect(value).toMatchObject({ ok: true, completed: 3 });expect(value.last.post.context_id).toBe("ctx-3");
+    expect(JSON.stringify(value)).not.toContain("private@example.test");
+  });
+  it("stops after a partial action and preserves the receipt through the host finalizer", async () => {
+    let count = 0;
+    const run = vi.fn(async () => stepReply(++count === 1 ? STEP_SUCCESS : STEP_PARTIAL, count === 1 ? 0 : 1));
+    const runtime = await host(run);const result = await runtime.execute(undefined, { action: "batch", contextId: "ctx-before", steps });
+    expect(result.isError).toBe(true);expect(run).toHaveBeenCalledTimes(2);
+    expect(receipt(result)).toMatchObject({ ok: false, completed: 1, stoppedAt: 1, last: { action_replayed: false } });
+  });
+  it("validates the whole sequence before input, including ownership overrides", async () => {
+    const run = vi.fn(async () => stepReply(STEP_SUCCESS, 0)),runtime = await host(run);
+    const result = await runtime.execute(undefined, { action: "batch", contextId: "ctx-before", steps: [steps[0], { ...steps[1], session: "s2" }] });
+    expect(result.isError).toBe(true);expect(run).not.toHaveBeenCalled();
+  });
+  it("cancels an in-flight child without running later steps or replaying it", async () => {
+    let entered!: () => void; const ready = new Promise<void>(resolve => { entered = resolve; });
+    const run = vi.fn(async (_args, options) => { entered(); await new Promise<void>(resolve => options?.signal?.addEventListener("abort", () => resolve(), { once: true })); return stepReply(STEP_PARTIAL, 1, { aborted: true }); });
+    const runtime = await host(run),controller = new AbortController();const pending = runtime.execute(controller, { action: "batch", contextId: "ctx-before", steps });
+    await ready;controller.abort();const result = await pending;expect(result.isError).toBe(true);expect(run).toHaveBeenCalledTimes(1);
+    expect(result.content.some(block => block.type === "text" && block.text.includes('"completed":0'))).toBe(true);
+  });
+});
diff --git a/packages/dsh-plugin-browserskill/tests/dsh-diagnostics.test.ts b/packages/dsh-plugin-browserskill/tests/dsh-diagnostics.test.ts
new file mode 100644
index 0000000..08167e0
--- /dev/null
+++ b/packages/dsh-plugin-browserskill/tests/dsh-diagnostics.test.ts
@@ -0,0 +1,30 @@
+import { DSH_BUILD_VERSION } from "../src/dsh-build-info";
+import { describe, expect, it, vi } from "vitest";
+import { createDshOperations, recordDshTiming } from "../src/dsh-operations";
+import { KeyedExecutor } from "../src/queue";
+import { SessionRegistry } from "../src/sessions";
+import type { ToolDeps } from "../src/tools";
+
+describe("browser diagnostics", () => {
+  it("reports compiled/CLI/extension versions and isolates bounded timings to the caller", async () => {
+    const registry = new SessionRegistry(5);
+    for (const id of ["s1", "s2"]) { registry.completeStart({ sessionId: id, startedAtMs: 0 }); registry.trackOwner(id, [id === "s1" ? "owner-a" : "owner-b"]); }
+    const run = vi.fn(async (args: string[]) => ({ code: 0, stderr: "", aborted: false, timedOut: false, stdout: args[0] === "--version" ? "bsk 0.4.2" : JSON.stringify(args[0] === "browsers" ? [{ instance_id: "synthetic", extension_version: "0.4.2", extension_protocol_version: "1.8" }] : { capabilities: { extension: { integration_version: DSH_BUILD_VERSION } } }) }));
+    const deps = { registry, runner: { run }, queue: new KeyedExecutor() } as unknown as ToolDeps;
+    recordDshTiming(deps, "s1", { operation: "fill", queueMs: 2, commandMs: 12, totalMs: 14, outcome: "ok" });
+    recordDshTiming(deps, "s2", { operation: "click", queueMs: 0, commandMs: 10, totalMs: 10, outcome: "ok" });
+    const doctor = createDshOperations(deps, {} as never)[1];
+    const result = await doctor.execute({}, { signal: new AbortController().signal, agent: { id: "owner-a" } } as never) as Record<string, any>;
+    expect(result.pluginVersion).toBe(DSH_BUILD_VERSION);
+    expect(result.checks.cli.compatible).toBe(true);expect(result.checks.extension.runtimeMatchesPlugin).toBe(true);
+    expect(result.recentTimings).toHaveLength(1);expect(result.recentTimings[0]).toEqual({ session: "s1", operation: "fill", queueMs: 2, commandMs: 12, totalMs: 14, outcome: "ok" });
+    expect(run.mock.calls.some(([args]) => args[0] === "start" || args[0] === "stop")).toBe(false);
+  });
+  it("reports missing CLI and disconnected browser without opening a task", async () => {
+    const run = vi.fn(async () => { throw new Error("unavailable"); });
+    const deps = { registry: { ownedByDsh: () => [] }, runner: { run } } as unknown as ToolDeps;
+    const result = await createDshOperations(deps, {} as never)[1].execute({}, { signal: new AbortController().signal, agent: { id: "owner" } } as never) as Record<string, any>;
+    expect(result.checks.cli.compatible).toBe(false);expect(result.checks.browsers.compatible).toBe(false);expect(result.recentTimings).toEqual([]);
+    expect(run).toHaveBeenCalledTimes(2);
+  });
+});
