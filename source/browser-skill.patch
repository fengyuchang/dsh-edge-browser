+it("locks human input across frames until explicit hold/help, preserving native input and ordered resets", () => {
+  document.body.innerHTML = '<input aria-label="City" data-bsk-overlay>';
+  const field = document.querySelector("input")!;
+  const read = collector(); read();
+  const state = (generation: number, mode = "ready") => ({ type: "bh-agent-overlay-state", epoch: "worker", generation,
+    sessionId: "task", mode: "control", cooperation: { mode, revision: generation, editing: false } });
+  const key = () => {
+    const event = new KeyboardEvent("keydown", { key: "a", bubbles: true, cancelable: true });
+    Object.defineProperty(event, "isTrusted", { value: true }); field.dispatchEvent(event); return event;
+  };
+  sendTabMessage(state(1));
+  expect(key().defaultPrevented).toBe(true);
+  sendTabMessage(state(2, "human"));
+  expect(key().defaultPrevented).toBe(true);
+  sendTabMessage(state(3, "yielding"));
+  expect(key().defaultPrevented).toBe(true);
+  sendTabMessage(state(4, "held"));
+  expect(key().defaultPrevented).toBe(false);
+  sendTabMessage(state(5));
+  sendTabMessage(state(4, "held")); // Late ownership updates cannot unlock.
+  expect(key().defaultPrevented).toBe(true);
+  sendTabMessage({ type: "bsk-help-request", requestId: "login", prompt: "Log in", selectors: [], timeoutMs: 60000 });
+  expect(key().defaultPrevented).toBe(false);
+  sendTabMessage({ type: "bsk-help-cancel", requestId: "other" });
+  expect(key().defaultPrevented).toBe(false);
+  sendTabMessage({ type: "bsk-help-cancel", requestId: "login" });
+  expect(key().defaultPrevented).toBe(true);
+
+  field.focus();
+  read(COOPERATION_ARM, "first", { type: "beforeinput", text: "native" });
+  const input = new InputEvent("beforeinput", { data: "native", inputType: "insertText", bubbles: true, cancelable: true });
+  Object.defineProperty(input, "isTrusted", { value: true }); field.dispatchEvent(input);
+  expect(input.defaultPrevented).toBe(false);
+  sendTabMessage({ type: "bh-agent-overlay-reset", epoch: "worker", generation: 6, sessionId: "task" });
+  expect(key().defaultPrevented).toBe(false);
+  sendTabMessage(state(5));
+  expect(key().defaultPrevented).toBe(false);
+});
+
+it("does not turn marker attributes into a page-input bypass during native click passthrough", () => {
