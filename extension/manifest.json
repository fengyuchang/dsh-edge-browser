{
  "manifest_version": 3,
  "name": "DeepSeek Harness",
  "description": "本机自用 Edge 浏览器助手，基于开源 BrowserSkill；供 DeepSeek Harness 使用现有登录、后台操作、实时预览和人工接手。",
  "version": "0.3.3",
  "version_name": "0.3.3 DSH annotations-2026-11-01-r3",
  "icons": {
    "16": "icon/logo.png",
    "32": "icon/logo.png",
    "48": "icon/logo.png",
    "128": "icon/logo.png"
  },
  "minimum_chrome_version": "125",
  "permissions": [
    "alarms",
    "activeTab",
    "debugger",
    "downloads",
    "idle",
    "notifications",
    "offscreen",
    "scripting",
    "tabs",
    "storage",
    "webNavigation",
    "windows",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "DeepSeek Harness",
    "default_icon": {
      "16": "icon/logo.png",
      "32": "icon/logo.png",
      "48": "icon/logo.png",
      "128": "icon/logo.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "dsh-annotate": {
      "suggested_key": "Alt+Shift+A",
      "description": "在当前 DeepSeek 任务页打开局部标注"
    }
  },
  "background": {
    "service_worker": "dsh-background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": false,
      "run_at": "document_end",
      "js": [
        "content-scripts/dsh-controls.js",
        "content-scripts/content.js",
        "content-scripts/dsh-pointer.js"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": false,
      "run_at": "document_end",
      "js": [
        "content-scripts/long-screenshot-page.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": [
        "content-scripts/record-frame.js"
      ],
      "match_origin_as_fallback": true
    }
  ]
}
